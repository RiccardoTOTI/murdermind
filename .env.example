# Local OpenAI-compatible LLM Server (Unsloth / vLLM / llama.cpp)
LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8888/v1
LLM_API_KEY=your-local-api-key-here
LLM_MODEL=unsloth/Qwen3.5-2B
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# Remote Provider Fallback (for Hugging Face Spaces or Cloud Deployment)
# Set LLM_PROVIDER=remote or auto to use HF Inference / OpenAI-compatible remote API
REMOTE_LLM_BASE_URL=https://router.huggingface.co/v1
REMOTE_LLM_API_KEY=
REMOTE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Persistence & App Config
MURDERMIND_DB_PATH=data/murdermind.db
MURDERMIND_OUTPUT_DIR=data/output
MURDERMIND_MAX_REVIEW_ITERATIONS=2
